PORT=8095
HOST=127.0.0.1
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:8095
WEB_DIST_DIR=../web/dist
# openssl rand -base64 32
ENCRYPTION_KEY=

# mock | meta
AI_PROVIDER=mock
# pipeline | agent
REPLY_ENGINE=pipeline
# Max model calls per UTC day across all shops (0 = unlimited)
AI_DAILY_CALL_LIMIT=3000
META_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=
META_TEXT_MODEL=muse-spark-1.3
META_VISION_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
META_SEGMENT_MODEL=sam-3.1
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

PDAFTAR_API_BASE_URL=https://dev-api.pdaftar.uz

IG_APP_ID=
IG_APP_SECRET=
IG_WEBHOOK_VERIFY_TOKEN=
IG_REDIRECT_URI=http://localhost:8095/auth/instagram/callback
IG_GRAPH_VERSION=v26.0
# Comma-separated ig user ids allowed to connect (empty = any)
IG_ALLOWED_ACCOUNT_IDS=
# Safe mode: only these usernames receive real messages; everyone else gets drafts
IG_SAFE_MODE=true
IG_SAFE_MODE_ALLOWED_USERNAMES=
# pDaftar's own accounts: their events also verify ambassador tasks in pDaftar
IG_OFFICIAL_ACCOUNT_IDS=
# pDaftar token issued with `automation:issue-token <shop> --social`
PDAFTAR_SOCIAL_TOKEN=
